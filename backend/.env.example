NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
ROUTE_SAMPLE_COUNT=10
POLLUTION_WEIGHT=1.0
HIGH_AQI_THRESHOLD=200
GRAPH_RETENTION_MINUTES=60
# Free map services: no map keys or Google billing required.
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-car
MAPS_USER_AGENT=svas-aasrav/1.0 (Delhi NCR hackathon route planner)

# Gemini: server only. Never use a VITE_ prefix for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional station AQI; leave token empty to retain Open-Meteo regional data.
WAQI_API_TOKEN=
STATION_MAX_DISTANCE_KM=10
ROUTE_TARGET_COUNT=4
